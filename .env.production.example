# Copy to .env.production on the VPS and fill in every value.
# Used both by docker-compose.prod.yml interpolation and inside the web container.

# ── Database (the bundled Postgres container) ───────────────────────────────
POSTGRES_USER=tsomi
POSTGRES_PASSWORD=
POSTGRES_DB=tsomi
# DATABASE_URL / DIRECT_URL are derived automatically in docker-compose.prod.yml.
# To use a managed database (e.g. Supabase) instead, remove the db/migrate
# services from the compose file and set DATABASE_URL here directly.

# ── Public site origin (used for sitemap, canonical/OG URLs) ────────────────
# Your real domain, with https — e.g. https://tsomi.ge
SITE_URL=

# ── Supabase Storage (product photo uploads from the admin panel) ───────────
# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin login ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=
# Run: npx tsx scripts/hash-password.ts "<your password>" — it prints the
# exact ADMIN_PASSWORD_HASH='...' line to paste here (single-quoted so the
# $ signs in the bcrypt hash survive Docker Compose's parsing).
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
