# Copy to .env.production on the VPS and fill in every value.
# Used both by docker-compose.prod.yml interpolation and inside the web container.

# ── Database (the bundled Postgres container) ───────────────────────────────
POSTGRES_USER=tsomi
POSTGRES_PASSWORD=
POSTGRES_DB=tsomi
# DATABASE_URL / DIRECT_URL are derived automatically in docker-compose.prod.yml.
# To use a managed database instead, remove the db/migrate services from the
# compose file and set DATABASE_URL here directly.

# ── Public site origin (used for sitemap, canonical/OG URLs) ────────────────
# Your real domain, with https — e.g. https://tsomistreetwear.ge
SITE_URL=

# Same domain WITHOUT the scheme — Caddy uses this to request the TLS
# certificate, and to redirect www to the bare domain.
SITE_DOMAIN=

# ── Product photo uploads ───────────────────────────────────────────────────
# Set by docker-compose.prod.yml to /app/uploads (the tsomi_uploads volume) —
# no configuration needed here. Listed only so it isn't a surprise.
# UPLOADS_DIR=/app/uploads

# ── Admin login ─────────────────────────────────────────────────────────────
ADMIN_EMAIL=
# Run: npx tsx scripts/hash-password.ts "<your password>" — it prints the
# exact ADMIN_PASSWORD_HASH='...' line to paste here (single-quoted so the
# $ signs in the bcrypt hash survive Docker Compose's parsing).
ADMIN_PASSWORD_HASH=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# ── Payments: Bank of Georgia e-commerce ────────────────────────────────────
# business.bog.ge → e-commerce → API keys. These are per-merchant: credentials
# from another BOG merchant account will not work here.
#
# Register the callback URL with BOG as:  https://<your-domain>/api/bog/callback
# It must be publicly reachable over HTTPS before any payment can complete.
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=

# Flat delivery charge added to every order, in tetri (500 = 5.00 ₾).
DELIVERY_FEE_TETRI=500

# Optional — only if BOG rotates the key they sign callbacks with.
BOG_PUBLIC_KEY=
