# Supabase → Project Settings → Database → Connection string → Transaction pooler (port 6543)
DATABASE_URL=

# Same screen → Direct connection (port 5432) — used only by drizzle-kit migrations
DIRECT_URL=

# Where admin-uploaded product photos are written. Defaults to ./uploads
# locally; production sets it to /app/uploads (a Docker volume).
UPLOADS_DIR=

# Chosen by you — the only admin login
ADMIN_EMAIL=

# Run: npx tsx scripts/hash-password.ts "<your password>" — it prints the
# exact ADMIN_PASSWORD_HASH= line to paste here. Don't paste a raw bcrypt
# hash yourself: Next.js expands `$name` in .env values, which corrupts an
# un-escaped hash (every `$` must become `\$`) — the script does this for you.
ADMIN_PASSWORD_HASH=

# Random secret for signing session cookies — generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=

# Public site origin for sitemap/OG URLs — optional locally (defaults to
# http://localhost:3000), required in production (e.g. https://tsomi.ge)
SITE_URL=

# ── Payments: Bank of Georgia e-commerce ────────────────────────────────────
# From your BOG merchant account (business.bog.ge → e-commerce → API keys).
# Checkout throws without these; the rest of the site runs fine unset.
BOG_CLIENT_ID=
BOG_CLIENT_SECRET=

# Flat delivery charge added to every order, in tetri (500 = 5.00 ₾).
# Defaults to 500 when unset.
DELIVERY_FEE_TETRI=500

# Optional: only set this if BOG rotates the key they sign callbacks with.
# Leave blank to use the key baked into src/lib/bog.ts.
BOG_PUBLIC_KEY=
